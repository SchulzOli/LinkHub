{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the Linkhaven window. HTTP is only used by device sync, which talks to the WebDAV folder the user enters (any address, so the scope is open).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*/*"
        },
        {
          "url": "https://*:*/*"
        },
        {
          "url": "http://*/*"
        },
        {
          "url": "http://*:*/*"
        }
      ]
    },
    "opener:default"
  ]
}
