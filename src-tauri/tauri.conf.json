{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Linkhaven",
  "version": "../package.json",
  "identifier": "io.github.schulzoli.linkhaven",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Linkhaven",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Productivity",
    "shortDescription": "Your links as a canvas, stored locally.",
    "longDescription": "Linkhaven is a local-first link dashboard: links, groups, images, charts and news feeds on a canvas. Optional end-to-end encrypted device sync through your own WebDAV folder.",
    "copyright": "\u00a9 SchulzOli"
  }
}
